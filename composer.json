{
    "name": "asignua/filament-scheduled-reports",
    "description": "Send any Filament table as an .xlsx on a schedule: save the filters, search, sort and columns once, pick a time and recipients, and the report arrives on time, exactly once, as the owner and never with more data than the owner can see.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "xlsx",
        "report",
        "scheduled",
        "schedule",
        "email",
        "export"
    ],
    "homepage": "https://github.com/asignua/filament-scheduled-reports",
    "support": {
        "issues": "https://github.com/asignua/filament-scheduled-reports/issues",
        "source": "https://github.com/asignua/filament-scheduled-reports"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "asignua/filament-xlsx-export": "^1.1",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentScheduledReports\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentScheduledReports\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentScheduledReports\\ScheduledReportsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
